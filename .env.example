# Database connection (SQLite for local standalone, or postgresql://user:pass@host:port/dbname for PostgreSQL / Supabase)
DATABASE_URL="file:./dev.db"

# Public site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin session encryption key
ADMIN_SECRET="your-secure-random-admin-secret"

# Razorpay Payment Gateway (Optional for production live payments, test mode enabled by default)
RAZORPAY_KEY_ID="rzp_test_yourKeyHere"
RAZORPAY_KEY_SECRET="yourSecretHere"

# -------------------------------------------------------------
# WhatsApp OTP (Free 1,000 conversations/month from Meta)
# -------------------------------------------------------------
# Official Meta WhatsApp Cloud API (developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="" # Optional: specify approved template or leave blank for direct text

# OR UltraMsg QR-Code Gateway (ultramsg.com)
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""

# -------------------------------------------------------------
# SMS OTP Gateways (Alternative fallback for Mobile SMS)
# -------------------------------------------------------------
# Option 1: Fast2SMS (Easiest setup in India - fast2sms.com)
FAST2SMS_API_KEY=""

# Option 2: MSG91 (DLT approved enterprise in India - msg91.com)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Option 3: Twilio (Global SMS - twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# -------------------------------------------------------------
# Google Firebase Phone Authentication (10,000 Free SMS/Month)
# -------------------------------------------------------------
# Get from Firebase Console (console.firebase.google.com) -> Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# -------------------------------------------------------------
# Gmail SMTP for Email OTP (100% Free - sends from your personal or store Gmail)
# -------------------------------------------------------------
# 1. Your Gmail address
GMAIL_USER=""
# 2. 16-character Google App Password (generate at myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=""

# Optional fallback: Resend API (resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Vedik Vana <onboarding@resend.dev>"

# -------------------------------------------------------------
# Veda Mitra Multilingual AI Concierge (Generative AI)
# -------------------------------------------------------------
# Optional: Google Gemini API Key (Get free key at aistudio.google.com)
# Note: The chatbot automatically uses the built-in neural AI cloud engine even if left blank!
GEMINI_API_KEY=""



